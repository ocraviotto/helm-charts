set -euo pipefail

chart="${1:-charts/leantime}"
release="leantime"

render() {
    helm template "$release" "$chart" --dependency-update "$@"
}

selector='select((.kind == "Job") and (.metadata.name == "leantime-migrate"))'

if [[ -n "$(render | yq e "$selector" -)" ]]; then
    echo "FAIL: a migration Job was rendered with migration.enabled=false" >&2
    exit 1
fi

job="$(
    render \
        --set migration.enabled=true \
        --set priorityClassName=leantime-critical \
        --set-json 'nodeSelector={"kubernetes.io/os":"linux"}' \
        --set-json 'tolerations=[{"key":"dedicated","operator":"Equal","value":"leantime","effect":"NoSchedule"}]' \
        --set-json 'affinity={"nodeAffinity":{"requiredDuringSchedulingIgnoredDuringExecution":{"nodeSelectorTerms":[{"matchExpressions":[{"key":"kubernetes.io/os","operator":"In","values":["linux"]}]}]}}}' \
        --set-json 'volumes=[{"name":"db-ca","configMap":{"name":"db-ca"}}]' \
        --set-json 'volumeMounts=[{"name":"db-ca","mountPath":"/etc/db-ca","readOnly":true}]' \
        | yq e "$selector" -
)"

if [[ -z "$job" ]]; then
    echo "FAIL: migration Job was not rendered with migration.enabled=true" >&2
    exit 1
fi

check() {
    local expression="$1"
    local message="$2"
    if ! printf '%s\n' "$job" | yq e -e "$expression" - >/dev/null; then
        echo "FAIL: $message" >&2
        exit 1
    fi
}

check '.metadata.name == "leantime-migrate"' "unexpected migration Job name"
check '.spec.template.spec.priorityClassName == "leantime-critical"' "priorityClassName is not propagated to the Job"
check '.spec.template.spec.nodeSelector["kubernetes.io/os"] == "linux"' "nodeSelector is not propagated to the Job"
check '.spec.template.spec.tolerations[0].key == "dedicated"' "tolerations are not propagated to the Job"
check '.spec.template.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution != null' "affinity is not propagated to the Job"
check '.spec.template.spec.volumes[] | select(.name == "db-ca") | .configMap.name == "db-ca"' "extra volumes are not propagated to the Job"
check '.spec.template.spec.containers[0].volumeMounts[] | select(.name == "db-ca") | .mountPath == "/etc/db-ca"' "extra volumeMounts are not propagated to the Job"

echo "migration Job rendering checks passed"
